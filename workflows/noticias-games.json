    },
    {
      "parameters": {
        "method": "POST",
        "url": "=  {{ $env.DISCORD_WEBHOOK_URL }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({\n  username: \"Game News\",\n  embeds: [{\n    title: $json.title,\n    url: $json.link,\n    description: $json.resumo,\n    color: $json.cor,\n    timestamp: $json.isoDate,\n    footer: { text: $json.categoria + \" • PC Gamer\" }\n  }]\n}) }}",
        "options": {
          "batching": {
            "batch": {
              "batchSize": 1
            }
          },
          "timeout": 10000
        }
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        1168,
        32
      ],
      "id": "b1c7a8a5-2188-4053-a8c8-ac699dc919ed",
      "name": "Enviar Discord",
      "retryOnFail": true,
      "waitBetweenTries": 3000
    },
    {
      "parameters": {
        "jsCode": "//Limite de itens noticias\nconst MAX_ITENS = 10;\n\n// Só passam notícias que citem pelo menos uma destas palavras\nconst PALAVRAS_CHAVE = [\n  'zelda', 'mario', 'pokemon', 'gta', 'playstation', 'ps5', 'xbox',\n  'nintendo', 'switch', 'steam', 'valve', 'release', 'launch', 'rpg',\n  'review', 'update', 'dlc', 'patch', 'trailer', 'announced', 'steam deck',\n  'pc', 'ps4', 'indie', 'multiplayer', 'free'\n];\n\n// Regras de categoria (a primeira que combinar vence) + cor do embed\nconst CATEGORIAS = [\n  { nome: 'Review',     cor: 3447003,  termos: ['review'] },\n  { nome: 'Promoção',   cor: 16705372, termos: ['sale', 'deal', 'discount', 'free', 'giveaway'] },\n  { nome: 'Lançamento', cor: 5763719,  termos: ['release', 'launch', 'announced', 'revealed', 'trailer'] },\n  { nome: 'Indústria',  cor: 15548997, termos: ['layoffs', 'studio', 'acquisition', 'acquires'] },\n];\nconst CATEGORIA_PADRAO = { nome: 'Geral', cor: 9807270 };\n\n//evita falsos positivos (ex.: \"sale\" dentro de \"wholesale\")\nconst contem = (texto, termos) =>\n  termos.some(t => new RegExp(`\\\\b${t}\\\\b`, 'i').test(texto));\n\nconst resultado = [];\n\nfor (const item of $input.all()) {\n  const n = item.json;\n\n  // Validação: descarta itens sem título, link ou data válida\n  if (!n.title || !n.link || isNaN(Date.parse(n.isoDate))) continue;\n\n  const texto = `${n.title} ${n.contentSnippet || ''}`;\n\n  // Filtro por palavras-chave\n  if (!contem(texto, PALAVRAS_CHAVE)) continue;\n\n  // Classificação por categoria\n  const cat = CATEGORIAS.find(c => contem(texto, c.termos)) || CATEGORIA_PADRAO;\n\n  resultado.push({\n    json: {\n      title: n.title,\n      link: n.link,\n      resumo: (n.contentSnippet || '').slice(0, 300),\n      isoDate: n.isoDate,\n      categoria: cat.nome,\n      cor: cat.cor,\n    },\n  });\n}\n\n// Ordena do mais novo para o mais antigo e limita a quantidade\nresultado.sort((a, b) => Date.parse(b.json.isoDate) - Date.parse(a.json.isoDate));\n\nreturn resultado.slice(0, MAX_ITENS);"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        720,
        32
      ],
