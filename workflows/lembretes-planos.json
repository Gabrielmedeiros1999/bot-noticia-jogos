    {
      "parameters": {
        "jsCode": "const f = $input.first().json;\n\nconst jogo = String(f['Jogo'] || '').trim();\nconst data = String(f['Data'] || '').trim();            \nconst hora = String(f['Hora (HH:MM)'] || '').trim();\nconst observacao = String(f['Observação'] || '').trim();\n\n// Validação dos campos\nif (!jogo) throw new Error('Informe o nome do jogo.');\nif (!/^\\d{4}-\\d{2}-\\d{2}$/.test(data)) throw new Error('Data inválida: ' + data);\nif (!/^([01]\\d|2[0-3]):[0-5]\\d$/.test(hora)) throw new Error('Hora inválida. Use HH:MM, ex.: 21:30');\n\n// Fuso de Brasília (UTC-3, sem horário de verão)\nconst quandoMs = Date.parse(`${data}T${hora}:00-03:00`);\nif (isNaN(quandoMs)) throw new Error('Data ou hora inválidas.');\nif (quandoMs < Date.now()) throw new Error('O horário informado já passou.');\n\nreturn [{\n  json: {\n    jogo,\n    observacao,\n    quando: new Date(quandoMs).toISOString(),\n    ts: Math.floor(quandoMs / 1000),   // usado pelo Discord para mostrar a hora local\n    status: 'pendente',\n  },\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
