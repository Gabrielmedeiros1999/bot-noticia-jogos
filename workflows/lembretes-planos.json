      "name": "Buscar Pendentes"
    },
    {
      "parameters": {
        "jsCode": "\nconst LEMBRAR_ANTES_MIN = 30;      // avisa quando faltar até este tempo\nconst TOLERANCIA_ATRASO_MIN = 15;  // avisa se o horário passou há pouco\n\nconst agora = Date.now();\nconst resultado = [];\n\nfor (const item of $input.all()) {\n  const p = item.json;\n  const quandoMs = Date.parse(String(p.quando));\n\n  // Validação: descarta linhas sem id ou com data inválida\n  if (!p.id || isNaN(quandoMs)) continue;\n\n  // Só passa o que está dentro da janela de lembrete\n  const faltamMin = Math.round((quandoMs - agora) / 60000);\n  if (faltamMin > LEMBRAR_ANTES_MIN || faltamMin < -TOLERANCIA_ATRASO_MIN) continue;\n\n  resultado.push({\n    json: {\n      id: p.id,\n      jogo: p.jogo,\n      observacao: p.observacao || '',\n      ts: Math.floor(quandoMs / 1000),\n      faltamMin,\n    },\n  });\n}\n\n// O plano mais próximo primeiro\nresultado.sort((a, b) => a.json.ts - b.json.ts);\n\nreturn resultado;"
      },
      "type": "n8n-nodes-base.code",
